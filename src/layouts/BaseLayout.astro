---
import '../styles/global.css';
import { SITE, absoluteUrl } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
}

const {
  title,
  description,
  jsonLd = [],
  ogImage,
  ogImageAlt,
  robots = 'index,follow,max-image-preview:large'
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImageUrl = absoluteUrl(ogImage ?? SITE.heroImage);
const ogImageAltText = ogImageAlt ?? `${SITE.fullNameAr} في ${SITE.cityAr}`;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07151f" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE.shortNameAr} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${SITE.fullNameAr} · ${SITE.cityAr}`} />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(SITE.heroImageWidth)} />
    <meta property="og:image:height" content={String(SITE.heroImageHeight)} />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAltText} />
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <slot />
    <div id="cookie-panel" class="cookie-panel" hidden aria-live="polite" aria-label="إعدادات الخصوصية">
      <strong>خصوصيتك أولاً</strong>
      <p class="m-0 mt-1 text-sm text-slate-300">نستخدم قياس الزيارات عبر Google Analytics 4 فقط بعد موافقتك. لا يحتاج الموقع إلى حساب ولا يخزن بيانات في قاعدة بيانات.</p>
      <div class="cookie-actions">
        <button id="accept-analytics" class="btn-primary">السماح بالتحليلات</button>
        <button id="reject-analytics" class="btn-ghost">المتابعة دون تحليلات</button>
      </div>
    </div>
    <script is:inline>
      (() => {
        const key = 'alex-memorial-analytics-consent';
        const panel = document.getElementById('cookie-panel');
        const accept = document.getElementById('accept-analytics');
        const reject = document.getElementById('reject-analytics');
        const settingsButtons = document.querySelectorAll('[data-cookie-settings]');
        const measurementId = 'G-HXM22WWPKP';
        let loaded = false;

        function loadAnalytics() {
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', measurementId, { anonymize_ip: true });
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
          document.head.appendChild(script);
        }

        function showPanel() { if (panel) panel.hidden = false; }
        function hidePanel() { if (panel) panel.hidden = true; }

        const saved = localStorage.getItem(key);
        if (saved === 'accepted') loadAnalytics();
        if (!saved) showPanel();

        accept?.addEventListener('click', () => {
          localStorage.setItem(key, 'accepted');
          loadAnalytics();
          hidePanel();
        });
        reject?.addEventListener('click', () => {
          localStorage.setItem(key, 'rejected');
          hidePanel();
        });
        settingsButtons.forEach((button) => button.addEventListener('click', showPanel));
      })();
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
