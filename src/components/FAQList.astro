---
import type { FaqItem } from "../data/faq";
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="mx-auto max-w-3xl divide-y divide-sand-200">
  {
    items.map((item, i) => (
      <details class="group py-4" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-lg font-semibold text-banyan-900">
          <span>{item.question}</span>
          <span
            aria-hidden="true"
            class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-banyan-900/20 text-banyan-700 transition-transform group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="mt-3 leading-relaxed text-banyan-800/85">{item.answer}</p>
      </details>
    ))
  }
</div>
