---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, absoluteUrl } from '../data/site';
import { guideUi, type Locale, localizedPath, entityName, cityName } from '../i18n';
import { ar } from '../content/ar';
import { en } from '../content/en';
import { zh } from '../content/zh';
import { nearby } from '../content/nearby';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const guide = { ar, en, zh }[locale];
const content = nearby[locale];

const homeLabel = { ar: 'الرئيسية', en: 'Home', zh: '首页' }[locale];
const detailsLabel = { ar: 'تفاصيل المعلم', en: 'View details', zh: '查看详情' }[locale];
const pageUrl = Astro.site ? new URL(localizedPath(locale, '/nearby-attractions/'), Astro.site).toString() : localizedPath(locale, '/nearby-attractions/');

const webpageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: content.title,
  description: content.description,
  inLanguage: locale === 'ar' ? 'ar-EG' : locale === 'en' ? 'en-US' : 'zh-CN',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#attraction` },
  primaryImageOfPage: absoluteUrl(SITE.heroImage),
  datePublished: SITE.lastUpdated,
  dateModified: SITE.lastUpdated
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: Astro.site ? new URL(localizedPath(locale, '/'), Astro.site).toString() : localizedPath(locale, '/') },
    { '@type': 'ListItem', position: 2, name: content.eyebrow }
  ]
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
const otherLocales = (['ar', 'en', 'zh'] as Locale[]).filter((l) => l !== locale);
---

<BaseLayout
  title={content.title}
  description={content.description}
  locale={locale}
  path="/nearby-attractions/"
  jsonLd={[webpageJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#06131c]/88 backdrop-blur-xl">
    <div class="container flex min-h-20 items-center justify-between gap-6">
      <a href={localizedPath(locale, '/')} aria-label={`${entityName(locale)} — ${homeLabel}`} class="flex shrink-0 items-center gap-3">
        <img src="/brand/logo.svg" alt={`${guideUi[locale].logo} — ${entityName(locale)}`} class="h-14 w-auto" />
        <span class="brand-text">
          <strong>{entityName(locale)}</strong>
          <small>{cityName(locale)} · {{ar:SITE.countryAr,en:SITE.countryEn,zh:SITE.countryZh}[locale]} · {SITE.plusCode}</small>
        </span>
      </a>
      <a class="btn-ghost text-sm" href={SITE.mapsShareUrl} target="_blank" rel="noopener noreferrer" aria-label={guideUi[locale].maps}>📍</a>
    </div>
    <div class="container flex items-center gap-2 py-1 text-xs">
      {otherLocales.map((l) => (
        <a class="lang-switch" href={localizedPath(l, '/nearby-attractions/')} hreflang={l}>{l === 'ar' ? 'العربية' : l === 'en' ? 'EN' : '中文'}</a>
      ))}
    </div>
  </header>

  <main id="top" class="pt-28">
    <section class="relative overflow-hidden py-20 md:py-28">
      <div class="container">
        <span class="eyebrow">{content.eyebrow}</span>
        <h1 class="hero-title">{content.hero.title}</h1>
        <p class="mt-6 max-w-2xl text-lg text-slate-200 md:text-xl">{content.hero.sub}</p>
        <p class="hero-alias mt-4 max-w-2xl">{content.hero.lead}</p>
        <p class="mt-6">
          <a class="btn-primary" href={localizedPath(locale, '/') + '#visit'}>{content.hero.cta}</a>
        </p>
      </div>
    </section>

    <section id="landmarks" class="py-16 md:py-20">
      <div class="container">
        <span class="eyebrow">{content.landmarks.eyebrow}</span>
        <h2 class="section-title">{content.landmarks.title}</h2>
        <p class="section-copy mt-4 max-w-3xl">{content.landmarks.intro}</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {content.landmarks.spots.map((l) => {
            const href = l.slug ? localizedPath(locale, `/${l.slug}/`) : null;
            const Tag = href ? 'a' : 'div';
            return (
              <Tag class="shell-border block p-6 transition hover:border-[#d2aa68]/60" {...(href ? { href } : {})}>
                <small class="text-[#d2aa68]">{l.tag} · {l.distance}</small>
                <h3 class="mt-1 text-2xl font-black">{l.name}</h3>
                <p class="mt-2 text-slate-300" set:html={l.desc} />
                {href && <span class="mt-3 inline-block text-sm font-semibold text-[#d2aa68]">{detailsLabel} →</span>}
              </Tag>
            );
          })}
        </div>
      </div>
    </section>

    <section id="foods" class="border-y border-[#d2aa68]/20 bg-[#081820] py-16 md:py-20">
      <div class="container">
        <span class="eyebrow">{content.foods.eyebrow}</span>
        <h2 class="section-title">{content.foods.title}</h2>
        <p class="section-copy mt-4 max-w-3xl">{content.foods.intro}</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {content.foods.items.map((f) => (
            <div class="place-card">
              <small>{f.tag}</small>
              <strong>{f.name}</strong>
              <p set:html={f.desc} />
            </div>
          ))}
        </div>
        <p class="mt-5 text-xs text-slate-500">{content.foods.note}</p>
      </div>
    </section>

    <section id="transport" class="py-16 md:py-20">
      <div class="container">
        <span class="eyebrow">{content.transport.eyebrow}</span>
        <h2 class="section-title">{content.transport.title}</h2>
        <p class="section-copy mt-4 max-w-3xl">{content.transport.intro}</p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {content.transport.cards.map((c) => (
            <div class="visit-card"><h3>{c.title}</h3><p set:html={c.text} /></div>
          ))}
        </div>
        <div class="map-wrap mt-10">
          <iframe src={SITE.mapsEmbedSrc} title={content.hero.title} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <p class="mt-5">
          <a class="btn-ghost" href={localizedPath(locale, '/') + '#map'}>{guide.nav.around} ↗</a>
        </p>
      </div>
    </section>

    <section id="tips" class="border-y border-[#d2aa68]/20 bg-[#0a1c25] py-16 md:py-20">
      <div class="container grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
        <div>
          <span class="eyebrow">{content.tips.eyebrow}</span>
          <h2 class="section-title">{content.tips.title}</h2>
        </div>
        <ul class="grid gap-4">
          {content.tips.items.map((item) => (
            <li class="shell-border flex items-start gap-3 p-4 text-slate-300">
              <span class="text-[#d2aa68]">◆</span>
              <span set:html={item} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="py-16 md:py-20">
      <div class="container grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:gap-16">
        <div>
          <span class="eyebrow">{guide.nav.faq}</span>
          <h2 class="section-title">{guide.nav.faq}</h2>
          <p class="section-copy">{content.faq.length} {locale === 'ar' ? 'سؤالاً شائعاً' : locale === 'en' ? 'common questions' : '个常见问题'}</p>
        </div>
        <div>
          {content.faq.map((item) => (
            <details class="faq">
              <summary>{item.q}</summary>
              <p set:html={item.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-20" aria-labelledby="sources-heading">
      <div class="container shell-border p-7 md:p-10">
        <span class="eyebrow">{guide.sources.eyebrow}</span>
        <h2 id="sources-heading" class="mt-3 text-2xl font-black">{guide.sources.title}</h2>
        <p class="mt-3 max-w-3xl text-sm text-slate-400" set:html={guide.sources.intro} />
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {guide.sources.links.map((l) => (
            <a class="source-link" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
          ))}
        </div>
        <p class="mt-6 text-xs text-slate-500">{guide.sources.updated}</p>
      </div>
    </section>
  </main>

  <footer class="border-t border-[#d2aa68]/20 bg-[#040e14] py-12">
    <div class="container flex flex-wrap items-center justify-between gap-4 text-sm text-slate-400">
      <span>{entityName(locale)} · {SITE.plusCode}</span>
      <div class="flex items-center gap-3">
        {(['ar', 'en', 'zh'] as Locale[]).map((l) => (
          <a class="lang-switch" href={localizedPath(l, '/nearby-attractions/')} hreflang={l}>{l === 'ar' ? 'العربية' : l === 'en' ? 'EN' : '中文'}</a>
        ))}
        <a class="nav-link" href={localizedPath(locale, '/')}>{homeLabel} ↑</a>
      </div>
    </div>
    <p class="container mt-5 text-sm text-slate-400">{guideUi[locale].disclaimer}</p>
  </footer>
</BaseLayout>
