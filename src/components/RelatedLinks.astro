---
interface Link {
  label: string;
  href: string;
  desc?: string;
}
interface Props {
  title?: string;
  links: Link[];
}
const { title = "延伸閱讀", links } = Astro.props;
---

<section aria-label={title} class="bg-sand-100/60">
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6">
    <h2 class="text-xl font-bold text-banyan-900">{title}</h2>
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="group rounded-2xl border border-sand-200 bg-white p-4 transition-colors hover:border-banyan-700"
          >
            <span class="flex items-center justify-between font-semibold text-banyan-900">
              {l.label}
              <span class="text-leaf-500 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
            {l.desc && <span class="mt-1 block text-sm text-banyan-800/70">{l.desc}</span>}
          </a>
        ))
      }
    </div>
  </div>
</section>
