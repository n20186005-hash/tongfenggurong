---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, absoluteUrl } from '../data/site';
import { guideUi, type Locale, localizedPath, entityName, cityName } from '../i18n';
import { ar } from '../content/ar';
import { en } from '../content/en';
import { zh } from '../content/zh';
import { spots, SPOT_SLUGS, spotExtras, type SpotSlug } from '../content/spots';

interface Props {
  slug: SpotSlug;
  locale: Locale;
}
const { slug, locale } = Astro.props;
const guide = { ar, en, zh }[locale];
const content = spots[slug][locale];
const extras = spotExtras[slug]?.[locale];

const path = `/${slug}/`;
const homeLabel = { ar: 'الرئيسية', en: 'Home', zh: '首页' }[locale];
const nearbyLabel = { ar: 'المعالم المجاورة', en: 'Nearby attractions', zh: '周边景点' }[locale];
const otherSpotsLabel = { ar: 'معالم أخرى قريبة', en: 'Other nearby sights', zh: '其他周边景点' }[locale];

const countryName = { ar: SITE.countryAr, en: SITE.countryEn, zh: SITE.countryZh }[locale];
const governorateName = { ar: SITE.governorateAr, en: SITE.governorateEn, zh: SITE.governorateZh }[locale];

const pageUrl = Astro.site ? new URL(localizedPath(locale, path), Astro.site).toString() : localizedPath(locale, path);
const homeUrl = Astro.site ? new URL(localizedPath(locale, '/'), Astro.site).toString() : localizedPath(locale, '/');
const nearbyUrl = Astro.site ? new URL(localizedPath(locale, '/nearby-attractions/'), Astro.site).toString() : localizedPath(locale, '/nearby-attractions/');

const otherSpots = SPOT_SLUGS.filter((s) => s !== slug).map((s) => ({ slug: s, name: spots[s][locale].name }));

const inLanguage = locale === 'ar' ? 'ar-EG' : locale === 'en' ? 'en-US' : 'zh-CN';

const spotJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${pageUrl}#attraction`,
  name: content.name,
  description: content.description,
  ...(pageUrl ? { url: pageUrl } : {}),
  isPartOf: { '@id': `${SITE.url}/#website` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: cityName(locale),
    addressRegion: governorateName,
    addressCountry: SITE.countryCode
  }
};

const webpageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: content.title,
  description: content.description,
  inLanguage,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${pageUrl}#attraction` },
  primaryImageOfPage: absoluteUrl(SITE.heroImage),
  datePublished: SITE.lastUpdated,
  dateModified: SITE.lastUpdated
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: nearbyLabel, item: nearbyUrl },
    { '@type': 'ListItem', position: 3, name: content.name, item: pageUrl }
  ]
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const otherLocales = (['ar', 'en', 'zh'] as Locale[]).filter((l) => l !== locale);
---

<BaseLayout
  title={content.title}
  description={content.description}
  locale={locale}
  path={path}
  jsonLd={[spotJsonLd, webpageJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#06131c]/88 backdrop-blur-xl">
    <div class="container flex min-h-20 items-center justify-between gap-6">
      <a href={localizedPath(locale, '/')} aria-label={`${entityName(locale)} — ${homeLabel}`} class="flex shrink-0 items-center gap-3">
        <img src="/brand/logo.svg" alt={`${guideUi[locale].logo} — ${entityName(locale)}`} class="h-14 w-auto" />
        <span class="brand-text">
          <strong>{entityName(locale)}</strong>
          <small>{cityName(locale)} · {countryName} · {SITE.plusCode}</small>
        </span>
      </a>
      <a class="btn-ghost text-sm" href={SITE.mapsShareUrl} target="_blank" rel="noopener noreferrer" aria-label={guideUi[locale].maps}>📍</a>
    </div>
    <div class="container flex items-center gap-2 py-1 text-xs">
      {otherLocales.map((l) => (
        <a class="lang-switch" href={localizedPath(l, path)} hreflang={l}>{l === 'ar' ? 'العربية' : l === 'en' ? 'EN' : '中文'}</a>
      ))}
    </div>
  </header>

  <main id="top" class="pt-28">
    <nav class="container breadcrumb pt-4" aria-label={nearbyLabel}>
      <ol>
        <li><a href={localizedPath(locale, '/')}>{homeLabel}</a></li>
        <li><a href={localizedPath(locale, '/nearby-attractions/')}>{nearbyLabel}</a></li>
        <li aria-current="page">{content.name}</li>
      </ol>
    </nav>

    <section class="relative overflow-hidden py-16 md:py-24">
      <div class="container">
        <span class="eyebrow">{content.eyebrow}</span>
        <h1 class="hero-title">{content.hero.name}</h1>
        <p class="mt-6 max-w-2xl text-lg text-slate-200 md:text-xl">{content.hero.sub}</p>
        <p class="hero-alias mt-4 max-w-2xl">{content.hero.lead}</p>
        <p class="mt-6 flex flex-wrap gap-3">
          <a class="btn-primary" href={localizedPath(locale, '/')}>{content.hero.cta}</a>
          <a class="btn-ghost" href={localizedPath(locale, '/nearby-attractions/')}>{nearbyLabel} ↗</a>
        </p>
      </div>
    </section>

    <section id="facts" class="py-12 md:py-16">
      <div class="container grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start">
        <div class="shell-border p-6 md:p-8">
          <h2 class="section-sub">{content.facts.title}</h2>
          <dl class="facts">
            {content.facts.items.map((item) => (
              <div>
                <dt>{item.k}</dt>
                <dd>{item.v}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-5 text-xs text-slate-500">{content.facts.note}</p>
        </div>
        <div>
          <span class="eyebrow">{content.about.eyebrow}</span>
          <h2 class="section-title">{content.about.title}</h2>
          {content.about.paras.map((p) => <p class="section-copy mt-4" set:html={p} />)}
        </div>
      </div>
    </section>

    <section id="highlights" class="border-y border-[#d2aa68]/20 bg-[#081820] py-16 md:py-20">
      <div class="container">
        <span class="eyebrow">{content.highlights.eyebrow}</span>
        <h2 class="section-title">{content.highlights.title}</h2>
        <p class="section-copy mt-4 max-w-3xl">{content.highlights.intro}</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {content.highlights.items.map((h) => (
            <div class="visit-card">
              <h3>{h.title}</h3>
              <p set:html={h.text} />
            </div>
          ))}
        </div>
      </div>
    </section>

    {extras && (
      <section id="info" class="border-y border-[#d2aa68]/20 py-16 md:py-20">
        <div class="container">
          <span class="eyebrow">{extras.info.eyebrow}</span>
          <h2 class="section-title">{extras.info.title}</h2>
          <div class="shell-border mt-8 p-6 md:p-8">
            <dl class="facts">
              {extras.info.items.map((item) => (
                <div>
                  <dt>{item.k}</dt>
                  <dd>{item.v}</dd>
                </div>
              ))}
            </dl>
            <p class="mt-5 text-xs text-slate-500">{extras.info.note}</p>
          </div>
        </div>
      </section>
    )}

    {extras && (
      <section id="charm" class="border-y border-[#d2aa68]/20 bg-[#0a1c25] py-16 md:py-20">
        <div class="container">
          <span class="eyebrow">{extras.charm.eyebrow}</span>
          <h2 class="section-title">{extras.charm.title}</h2>
          <p class="section-copy mt-4 max-w-3xl">{extras.charm.intro}</p>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {extras.charm.items.map((c) => (
              <div class="visit-card">
                <h3>{c.title}</h3>
                {c.paras.map((p) => <p set:html={p} />)}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section id="visit" class="py-16 md:py-20">
      <div class="container">
        <span class="eyebrow">{content.visit.eyebrow}</span>
        <h2 class="section-title">{content.visit.title}</h2>
        <p class="section-copy mt-4 max-w-3xl">{content.visit.intro}</p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {content.visit.cards.map((c) => (
            <div class="shell-border p-5">
              <h3 class="text-[#d2aa68]">{c.title}</h3>
              <p class="mt-1 text-slate-300" set:html={c.text} />
            </div>
          ))}
        </div>
        <p class="mt-5 text-xs text-slate-500">{content.visit.note}</p>
      </div>
    </section>

    {extras && (
      <section id="access" class="border-y border-[#d2aa68]/20 bg-[#081820] py-16 md:py-20">
        <div class="container">
          <span class="eyebrow">{extras.access.eyebrow}</span>
          <h2 class="section-title">{extras.access.title}</h2>
          <p class="section-copy mt-4 max-w-3xl">{extras.access.intro}</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {extras.access.cards.map((c) => (
              <div class="shell-border p-5">
                <h3 class="text-[#d2aa68]">{c.title}</h3>
                <p class="mt-1 text-slate-300" set:html={c.text} />
              </div>
            ))}
          </div>
          <p class="mt-5 text-xs text-slate-500">{extras.access.note}</p>
        </div>
      </section>
    )}

    {extras && (
      <section id="route" class="py-16 md:py-20">
        <div class="container grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:gap-16">
          <div>
            <span class="eyebrow">{extras.route.eyebrow}</span>
            <h2 class="section-title">{extras.route.title}</h2>
            <p class="section-copy mt-4 max-w-3xl">{extras.route.intro}</p>
            <ol class="mt-8 grid gap-4">
              {extras.route.steps.map((s, i) => (
                <li class="shell-border flex gap-4 p-5">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#d2aa68]/40 font-black text-[#d2aa68]">{i + 1}</span>
                  <div>
                    <h3 class="text-[#d2aa68]">{s.title}</h3>
                    <p class="mt-1 text-slate-300" set:html={s.text} />
                  </div>
                </li>
              ))}
            </ol>
            <p class="mt-5 text-xs text-slate-500">{extras.route.note}</p>
          </div>
          <div class="shell-border h-fit p-6 md:p-8">
            <h3 class="section-sub">{extras.route.notesTitle}</h3>
            <ul class="mt-3 grid gap-3">
              {extras.route.notes.map((n) => (
                <li class="flex gap-3 text-slate-300">
                  <span class="text-[#d2aa68]">•</span>
                  <span set:html={n} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <section id="relation" class="border-y border-[#d2aa68]/20 bg-[#0a1c25] py-16 md:py-20">
      <div class="container grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <span class="eyebrow">{content.relation.eyebrow}</span>
          <h2 class="section-title">{content.relation.title}</h2>
        </div>
        <div>
          <p class="section-copy" set:html={content.relation.text} />
          <div class="mt-6">
            <h3 class="section-sub">{otherSpotsLabel}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {otherSpots.map((s) => (
                <a class="lang-switch" href={localizedPath(locale, `/${s.slug}/`)}>{s.name}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="py-16 md:py-20">
      <div class="container grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:gap-16">
        <div>
          <span class="eyebrow">{guide.nav.faq}</span>
          <h2 class="section-title">{guide.nav.faq}</h2>
          <p class="section-copy">{content.faq.length} {locale === 'ar' ? 'سؤالاً شائعاً' : locale === 'en' ? 'common questions' : '个常见问题'}</p>
        </div>
        <div>
          {content.faq.map((item) => (
            <details class="faq">
              <summary>{item.q}</summary>
              <p set:html={item.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    {extras && (
      <section id="reviews" class="border-y border-[#d2aa68]/20 bg-[#081820] py-16 md:py-20">
        <div class="container">
          <span class="eyebrow">{extras.reviews.eyebrow}</span>
          <h2 class="section-title">{extras.reviews.title}</h2>
          <p class="section-copy mt-4 max-w-3xl">{extras.reviews.text}</p>
          <p class="mt-6">
            <a class="btn-primary" href={SITE.mapsShareUrl} target="_blank" rel="noopener noreferrer">{extras.reviews.cta} ↗</a>
          </p>
        </div>
      </section>
    )}

    <section class="pb-20" aria-labelledby="sources-heading">
      <div class="container shell-border p-7 md:p-10">
        <span class="eyebrow">{guide.sources.eyebrow}</span>
        <h2 id="sources-heading" class="mt-3 text-2xl font-black">{guide.sources.title}</h2>
        <p class="mt-3 max-w-3xl text-sm text-slate-400" set:html={guide.sources.intro} />
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {guide.sources.links.map((l) => (
            <a class="source-link" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
          ))}
        </div>
        <p class="mt-6 text-xs text-slate-500">{guide.sources.updated}</p>
      </div>
    </section>
  </main>

  <footer class="border-t border-[#d2aa68]/20 bg-[#040e14] py-12">
    <div class="container flex flex-wrap items-center justify-between gap-4 text-sm text-slate-400">
      <span>{entityName(locale)} · {SITE.plusCode}</span>
      <div class="flex items-center gap-3">
        {(['ar', 'en', 'zh'] as Locale[]).map((l) => (
          <a class="lang-switch" href={localizedPath(l, path)} hreflang={l}>{l === 'ar' ? 'العربية' : l === 'en' ? 'EN' : '中文'}</a>
        ))}
        <a class="nav-link" href={localizedPath(locale, '/')}>{homeLabel} ↑</a>
      </div>
    </div>
    <p class="container mt-5 text-sm text-slate-400">{guideUi[locale].disclaimer}</p>
  </footer>
</BaseLayout>
