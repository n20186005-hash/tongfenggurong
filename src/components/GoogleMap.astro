---
import { place } from "../data/place";
const embedUrl =
  `https://www.google.com/maps?q=${place.coordinates.latitude},` +
  `${place.coordinates.longitude}&z=16&output=embed`;
---

<section aria-labelledby="location-title" class="mx-auto max-w-6xl px-4 py-16 md:px-6">
  <div class="mb-6">
    <p class="text-sm font-semibold tracking-wide text-temple-700">位置與導航</p>
    <h2 id="location-title" class="mt-2 text-3xl font-bold text-banyan-900">
      前往通樑古榕
    </h2>
    <p class="mt-3 max-w-2xl text-banyan-800/80">
      開放狀態、即時路況、停車情形與旅客評論可能變動，出發前請查看 Google Maps。
    </p>
  </div>

  <div class="mb-6 flex flex-wrap gap-3">
    <a
      href={place.directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-banyan-900 px-6 py-3 font-semibold text-sand-50 transition-colors hover:bg-banyan-800"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        <circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="2"/>
      </svg>
      開始導航
    </a>
    <a
      href={place.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full border border-banyan-900/25 px-6 py-3 font-semibold text-banyan-900 transition-colors hover:bg-sand-100"
    >
      查看地點與評論
    </a>
  </div>

  <div class="overflow-hidden rounded-3xl border border-sand-200 shadow-sm">
    <iframe
      src={embedUrl}
      title="通樑古榕 Tongliang Great Banyan 在 Google Maps 上的位置"
      loading="lazy"
      class="aspect-[4/3] h-full w-full border-0 md:aspect-[16/7]"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
</section>
