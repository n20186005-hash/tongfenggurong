---
import Logo from "./Logo.astro";
import { mainNav } from "../data/navigation";
const current = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-sand-200/70 bg-sand-50/90 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
    <Logo />

    <!-- 桌面導覽 -->
    <nav aria-label="主導覽" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.href ? "page" : undefined}
                class:list={[
                  "rounded-full px-3 py-2 text-sm font-medium transition-colors",
                  current === item.href
                    ? "bg-banyan-900 text-sand-50"
                    : "text-banyan-800 hover:bg-sand-100",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href="/faq/"
      class="hidden rounded-full border border-banyan-900/20 px-4 py-2 text-sm font-semibold text-banyan-900 hover:bg-sand-100 lg:inline-block"
      >常見問題</a
    >

    <!-- 行動版選單（純 HTML details，無需 JS 框架） -->
    <details class="group relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-1 rounded-full border border-banyan-900/20 px-3 py-2 text-sm font-semibold text-banyan-900"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        選單
      </summary>
      <nav
        aria-label="行動版導覽"
        class="absolute right-0 mt-2 w-64 rounded-2xl border border-sand-200 bg-sand-50 p-2 shadow-xl"
      >
        <ul class="flex flex-col">
          {
            mainNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={current === item.href ? "page" : undefined}
                  class="block rounded-xl px-3 py-2.5 text-sm font-medium text-banyan-800 hover:bg-sand-100"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/faq/"
              class="block rounded-xl px-3 py-2.5 text-sm font-medium text-banyan-800 hover:bg-sand-100"
              >常見問題</a
            >
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
