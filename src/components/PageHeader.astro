---
import Breadcrumbs from "./Breadcrumbs.astro";
interface Crumb {
  name: string;
  path: string;
}
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  breadcrumbs: Crumb[];
}
const { eyebrow, title, subtitle, breadcrumbs } = Astro.props;
---

<header class="relative overflow-hidden bg-banyan-950 text-sand-50">
  <div
    class="pointer-events-none absolute inset-0 opacity-25"
    style="background: radial-gradient(120% 120% at 20% 0%, #42654d 0%, transparent 55%), radial-gradient(120% 120% at 100% 100%, #527b84 0%, transparent 60%);"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-4xl px-4 py-14 md:px-6 md:py-20">
    <Breadcrumbs items={breadcrumbs} tone="light" />
    <p class="mt-6 text-sm font-semibold tracking-[0.2em] text-leaf-300 uppercase">
      {eyebrow}
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">{title}</h1>
    {
      subtitle && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-sand-100/85">
          {subtitle}
        </p>
      )
    }
  </div>
</header>
