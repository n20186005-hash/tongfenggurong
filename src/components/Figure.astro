---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="my-8 not-prose">
  <div class="overflow-hidden rounded-3xl border border-sand-200 shadow-sm">
    <Image
      src={src}
      alt={alt}
      widths={[480, 768, 1024]}
      sizes="(min-width: 768px) 720px, 90vw"
      loading="lazy"
      class="h-full w-full object-cover"
    />
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-center text-sm text-banyan-800/60">
        {caption}
      </figcaption>
    )
  }
</figure>
