---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync } from 'node:fs';

const title = 'النصب التذكاري للجندي البحري المجهول | دليل زيارة المنشية – الإسكندرية';
const description = 'دليل عربي مستقل لزيارة النصب التذكاري للجندي البحري المجهول في ميدان الجندي المجهول بالمنشية: القصة، الوصول، أفضل وقت، المواقف، الطعام والمعالم القريبة.';
const pageUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;

const photoDefs = [
  { local: '/images/memorial-front.jpg', file: '../../public/images/memorial-front.jpg', remote: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/The_Alexandria_Naval_Unknown_Soldier_Memorial_01.jpg?width=1800', alt: 'واجهة النصب التذكاري للجندي البحري المجهول في المنشية بالإسكندرية', credit: 'Saleh Abdelrazeq / Wikimedia Commons — CC BY-SA 4.0' },
  { local: '/images/memorial-columns.jpg', file: '../../public/images/memorial-columns.jpg', remote: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/The_Alexandria_Naval_Unknown_Soldier_Memorial_04.jpg?width=1400', alt: 'تفاصيل الأعمدة والكتابات في نصب الجندي البحري المجهول بالإسكندرية', credit: 'Saleh Abdelrazeq / Wikimedia Commons — CC BY-SA 4.0' },
  { local: '/images/memorial-side.jpg', file: '../../public/images/memorial-side.jpg', remote: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/The_Alexandria_Naval_Unknown_Soldier_Memorial_06.jpg?width=1400', alt: 'منظور جانبي للنصب التذكاري البحري والسماء في الإسكندرية', credit: 'Saleh Abdelrazeq / Wikimedia Commons — CC BY-SA 4.0' },
  { local: '/images/memorial-square.jpg', file: '../../public/images/memorial-square.jpg', remote: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Monument_of_the_Navy_Unknown_Soldier_in_Alexandria_(6).jpg?width=1400', alt: 'النصب التذكاري البحري كما يبدو من ميدان المنشية', credit: 'Moro 2088 / Wikimedia Commons — CC BY-SA 3.0' }
];

const photos = photoDefs.map((photo) => ({
  ...photo,
  src: existsSync(new URL(photo.file, import.meta.url)) ? photo.local : photo.remote
}));

const faqItems = [
  {
    q: 'هل زيارة النصب مجانية؟',
    a: 'نعم. النصب يقع في ميدان عام بالمنشية ولا توجد بوابة تذاكر للمرور إلى ساحة المشاهدة المعتادة.'
  },
  {
    q: 'ما أفضل وقت للزيارة؟',
    a: 'الصباح المبكر مناسب للهدوء والتصوير، وقبل الغروب يمنح الحجر ضوءاً أكثر دفئاً. في المساء يصبح المشهد أكثر حضرية مع إنارة المنطقة وحركة الكورنيش.'
  },
  {
    q: 'كم أحتاج من الوقت؟',
    a: 'غالباً تكفي 15 إلى 30 دقيقة لمشاهدة النصب وقراءة تفاصيله والتقاط الصور، ويمكن تمديد الزيارة بربطها بجولة في المنشية وبحري.'
  },
  {
    q: 'هل المكان مفتوح طوال اليوم؟',
    a: 'تتعامل الخرائط المحلية مع الساحة باعتبارها مفتوحة على مدار اليوم. قد تتغير إمكانية الاقتراب أثناء المراسم الرسمية أو ترتيبات الأمن، لذلك اتبع الإرشادات الموجودة في الموقع.'
  },
  {
    q: 'كيف أصل إليه بالمواصلات العامة؟',
    a: 'المنشية في قلب شبكة وسط الإسكندرية. يمكن النزول قرب محطات وسط البلد مثل سانت كاترين أو محطة الرمل ثم إكمال المسافة سيراً، كما أن سيارات الأجرة وتطبيقات النقل تصل مباشرة إلى ميدان الجندي المجهول.'
  },
  {
    q: 'هل يوجد موقف سيارات مخصص؟',
    a: 'لا تعتمد على وجود موقف خاص بالنصب. مواقف الشوارع في المنشية محدودة وتتغير حسب الزحام، لذلك يفضَّل استخدام موقف عام قريب أو سيارة أجرة إذا كنت تزور المنطقة في وقت مزدحم.'
  },
  {
    q: 'هل الزيارة مناسبة لذوي صعوبة الحركة؟',
    a: 'يمكن مشاهدة النصب من مستوى الميدان، لكن التصميم يتضمن درجات ومنصات مرتفعة. من الأفضل تقييم المسار عند الوصول واختيار نقاط المشاهدة الأقل اعتماداً على السلالم.'
  }
];

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'النصب التذكاري للجندي البحري المجهول',
  alternateName: ['النصب التذكاري للجندي المجهول بالإسكندرية', 'Alexandria Naval Unknown Soldier Memorial'],
  description,
  ...(pageUrl ? { url: pageUrl } : {}),
  hasMap: 'https://maps.app.goo.gl/Hzrwki23zawzREuz8',
  image: photos.map((photo) => photo.src),
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ميدان الجندي المجهول، المنشية الكبرى',
    addressLocality: 'المنشية',
    addressRegion: 'محافظة الإسكندرية',
    postalCode: '5361033',
    addressCountry: 'EG'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 31.19972,
    longitude: 29.89361
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'https://schema.org/Monday',
      'https://schema.org/Tuesday',
      'https://schema.org/Wednesday',
      'https://schema.org/Thursday',
      'https://schema.org/Friday',
      'https://schema.org/Saturday',
      'https://schema.org/Sunday'
    ],
    opens: '00:00',
    closes: '23:59'
  }],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.4,
    reviewCount: 18296,
    bestRating: 5,
    worstRating: 1
  }
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};
---
<BaseLayout title={title} description={description} jsonLd={[attractionJsonLd, faqJsonLd]}>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#06131c]/88 backdrop-blur-xl">
    <div class="container flex min-h-20 items-center justify-between gap-6">
      <a href="#top" aria-label="العودة إلى بداية الصفحة" class="shrink-0">
        <img src="/brand/logo.svg" alt="شعار النصب التذكاري للجندي البحري المجهول" class="h-14 w-auto" />
      </a>
      <nav aria-label="التنقل الرئيسي" class="hidden items-center gap-6 text-sm font-bold lg:flex">
        <a class="nav-link" href="#story">الحكاية</a>
        <a class="nav-link" href="#visit">الزيارة</a>
        <a class="nav-link" href="#map">الوصول</a>
        <a class="nav-link" href="#around">حولنا</a>
        <a class="nav-link" href="#faq">الأسئلة</a>
      </nav>
      <a class="btn-ghost text-sm" href="https://maps.app.goo.gl/Hzrwki23zawzREuz8" target="_blank" rel="noreferrer">فتح الخريطة ↗</a>
    </div>
  </header>

  <main id="top">
    <section class="relative min-h-[94vh] overflow-hidden pt-20">
      <img src={photos[0].src} alt={photos[0].alt} fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(3,11,16,.18),rgba(3,11,16,.62)_45%,rgba(3,11,16,.94)),linear-gradient(0deg,rgba(3,11,16,.92),transparent_45%)]"></div>
      <div class="absolute inset-y-0 right-[8%] hidden w-px bg-[#d2aa68]/35 lg:block"></div>
      <div class="container relative z-10 grid min-h-[calc(94vh-5rem)] items-end py-14 lg:grid-cols-[1.15fr_.85fr] lg:gap-12 lg:pb-20">
        <div class="lg:col-start-2">
          <span class="eyebrow">ذاكرة على حافة المتوسط</span>
          <h1 class="mt-4 max-w-[12ch] text-[clamp(3rem,8vw,7.4rem)] font-black leading-[.94] tracking-[-.055em]">الجندي البحري<br/><span class="text-[#d2aa68]">المجهول</span></h1>
          <p class="mt-6 max-w-2xl text-lg text-slate-200 md:text-xl">نصب بحري كلاسيكي يطل على شرق الميناء من قلب المنشية؛ مكان قصير الزيارة، ثقيل الذاكرة، وممتاز كبداية لجولة مشي على كورنيش الإسكندرية القديمة.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="btn-primary" href="#visit">خطط للزيارة ↓</a>
            <a class="btn-ghost" href="#story">اقرأ الحكاية</a>
          </div>
        </div>
        <div class="mt-12 self-end lg:mt-0">
          <div class="shell-border grid overflow-hidden rounded-sm sm:grid-cols-2">
            <div class="info-cell"><span class="info-kicker">التقييم على خرائط Google</span><span class="info-value">★ 4.4 · 18,296 مراجعة</span></div>
            <div class="info-cell"><span class="info-kicker">الموقع</span><span class="info-value">المنشية · الإسكندرية</span></div>
            <div class="info-cell"><span class="info-kicker">الدخول</span><span class="info-value">مجاني</span></div>
            <div class="info-cell"><span class="info-kicker">المدة المعتادة</span><span class="info-value">15–30 دقيقة</span></div>
          </div>
        </div>
      </div>
      <div class="absolute bottom-3 left-4 z-10 text-[10px] text-white/60">{photos[0].credit}</div>
    </section>

    <div class="brass-rule"></div>

    <section id="story" class="arch-motif py-24 md:py-32">
      <div class="container grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
        <div>
          <span class="eyebrow">القصة</span>
          <h2 class="section-title">من ذكرى الخديوي<br/>إلى ذاكرة البحر.</h2>
          <p class="section-copy">النصب في صورته المعمارية الحالية يسبق وظيفته التذكارية البحرية. شُيّد في ثلاثينيات القرن العشرين بمبادرة من الجالية الإيطالية تكريماً للخديوي إسماعيل، ثم تغيّر مع التحولات السياسية في مصر ليصبح لاحقاً نصباً للجندي البحري المجهول.</p>
        </div>
        <div class="max-w-3xl">
          <div class="timeline-item">
            <strong class="text-[#d2aa68]">1933 · أصل معماري كلاسيكي</strong>
            <p class="mt-2 text-slate-300">ارتبط البناء الأول بذكرى الخديوي إسماعيل، وصممه المعماري الإيطالي إرنستو فيروتشي بروح النصب الكلاسيكية ذات الأعمدة والكتلة الحجرية المهيبة.</p>
          </div>
          <div class="timeline-item">
            <strong class="text-[#d2aa68]">بعد ثورة 1952 · معنى جديد للميدان</strong>
            <p class="mt-2 text-slate-300">تغيرت الدلالة السياسية والرمزية للموقع، ومع الوقت جرى تحويل النصب من تخليد حاكم إلى تخليد جنود فقدوا في البحر.</p>
          </div>
          <div class="timeline-item">
            <strong class="text-[#d2aa68]">منتصف الستينيات · الجندي البحري المجهول</strong>
            <p class="mt-2 text-slate-300">صدر قرار التحويل في الستينيات، واستقر الاسم والوظيفة التذكارية المرتبطة بالقوات البحرية وشهداء المعارك البحرية.</p>
          </div>
          <div class="timeline-item">
            <strong class="text-[#d2aa68]">اليوم · نقطة ذاكرة في المشهد اليومي</strong>
            <p class="mt-2 text-slate-300">يبقى النصب جزءاً من الحياة اليومية في المنشية، وفي الوقت نفسه إطاراً للمراسم ووضع أكاليل الزهور في مناسبات رسمية.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 md:pb-32" aria-labelledby="gallery-heading">
      <div class="container">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
          <div>
            <span class="eyebrow">تفاصيل الحجر</span>
            <h2 id="gallery-heading" class="section-title mb-0">النصب كما تراه من الميدان.</h2>
          </div>
          <p class="max-w-md text-sm text-slate-400">صور حقيقية موثقة من Wikimedia Commons. تظهر الاعتمادات والتراخيص مع كل صورة.</p>
        </div>
        <div class="grid auto-rows-[220px] gap-3 md:grid-cols-12 md:auto-rows-[260px]">
          <figure class="photo-frame m-0 md:col-span-7 md:row-span-2">
            <img src={photos[1].src} alt={photos[1].alt} loading="lazy" decoding="async" />
            <figcaption class="photo-caption">واجهة الأعمدة · {photos[1].credit}</figcaption>
          </figure>
          <figure class="photo-frame m-0 md:col-span-5">
            <img src={photos[2].src} alt={photos[2].alt} loading="lazy" decoding="async" />
            <figcaption class="photo-caption">منظور جانبي · {photos[2].credit}</figcaption>
          </figure>
          <figure class="photo-frame m-0 md:col-span-5">
            <img src={photos[3].src} alt={photos[3].alt} loading="lazy" decoding="async" />
            <figcaption class="photo-caption">من الميدان · {photos[3].credit}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="visit" class="border-y border-[#d2aa68]/20 bg-[#0a1c25] py-24 md:py-28">
      <div class="container grid gap-14 lg:grid-cols-[.95fr_1.05fr]">
        <div>
          <span class="eyebrow">الزيارة</span>
          <h2 class="section-title">زيارة قصيرة،<br/>لكنها ليست عابرة.</h2>
          <p class="section-copy">النصب ليس متحفاً مغلقاً ولا يحتاج إلى برنامج طويل. قوته في موقعه: تقف أمام ذاكرة بحرية، ثم تخرج مباشرة إلى المنشية والأسواق وواجهة شرق الميناء.</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <div class="visit-card"><h3>التذاكر / التكلفة</h3><p>لا توجد تذكرة دخول للساحة العامة؛ المشاهدة المعتادة مجانية.</p></div>
            <div class="visit-card"><h3>ساعات الوصول</h3><p>الساحة متاحة على مدار اليوم عادةً، مع احتمال قيود مؤقتة أثناء المراسم.</p></div>
            <div class="visit-card"><h3>أفضل وقت</h3><p>الصباح للهدوء، وقبل الغروب لضوء دافئ على الحجر، والمساء لأجواء الكورنيش.</p></div>
            <div class="visit-card"><h3>مدة مناسبة</h3><p>15–30 دقيقة للنصب وحده؛ ساعتان أو أكثر إذا ربطته بجولة المنشية وبحري.</p></div>
          </div>
        </div>
        <div class="shell-border p-7 md:p-10">
          <span class="text-xs font-black tracking-widest text-[#d2aa68]">مسار مقترح</span>
          <h3 class="mt-2 text-2xl font-black">من المنشية إلى بحري على إيقاع البحر</h3>
          <ol class="mt-7 grid gap-5 text-slate-300">
            <li class="grid grid-cols-[2.4rem_1fr] gap-3"><span class="grid h-9 w-9 place-items-center rounded-full border border-[#d2aa68]/50 text-[#d2aa68]">١</span><div><strong class="text-white">ابدأ بالنصب.</strong><br/>شاهد الواجهة والأعمدة والكتابات وخذ صورة واسعة من الميدان.</div></li>
            <li class="grid grid-cols-[2.4rem_1fr] gap-3"><span class="grid h-9 w-9 place-items-center rounded-full border border-[#d2aa68]/50 text-[#d2aa68]">٢</span><div><strong class="text-white">اتجه غرباً نحو الأنفوشي.</strong><br/>يمتد المسار عبر أحياء مرتبطة بالميناء والأسواق القديمة.</div></li>
            <li class="grid grid-cols-[2.4rem_1fr] gap-3"><span class="grid h-9 w-9 place-items-center rounded-full border border-[#d2aa68]/50 text-[#d2aa68]">٣</span><div><strong class="text-white">مرّ بمسجد أبي العباس المرسي.</strong><br/>معلم كبير في بحري ويمكن الوصول إليه تقريباً خلال عشرين دقيقة مشياً.</div></li>
            <li class="grid grid-cols-[2.4rem_1fr] gap-3"><span class="grid h-9 w-9 place-items-center rounded-full border border-[#d2aa68]/50 text-[#d2aa68]">٤</span><div><strong class="text-white">اختم بقلعة قايتباي.</strong><br/>تقريباً نصف ساعة مشياً من النصب، مع امتداد واضح لواجهة الميناء الشرقي.</div></li>
          </ol>
        </div>
      </div>
    </section>

    <section id="map" class="py-24 md:py-32">
      <div class="container">
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
          <div>
            <span class="eyebrow">الوصول</span>
            <h2 class="section-title">ميدان الجندي المجهول، المنشية.</h2>
            <p class="section-copy">العنوان: ميدان الجندي المجهول، المنشية الكبرى، قسم المنشية، محافظة الإسكندرية 5361033. الرمز المختصر: 5VXV+XG.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="visit-card"><h3>من محطة الرمل</h3><p>نحو 12 دقيقة مشياً بحسب المسار، أو رحلة قصيرة بسيارة أجرة داخل وسط البلد.</p></div>
            <div class="visit-card"><h3>من سانت كاترين</h3><p>نحو 8 دقائق مشياً إلى محيط الميدان؛ خيار جيد إذا وصلت بترام أو مواصلات وسط البلد.</p></div>
            <div class="visit-card"><h3>من محطة مصر</h3><p>يمكن السير في حدود 20–25 دقيقة تقريباً أو استخدام سيارة أجرة لتجنب ازدحام الشوارع.</p></div>
            <div class="visit-card"><h3>بسيارة أجرة</h3><p>اطلب «ميدان الجندي المجهول – المنشية». الاسم معروف ويضعك مباشرة في قلب المنطقة.</p></div>
          </div>
        </div>
        <div class="map-wrap mt-10">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6070.070081511815!2d29.89117661285759!3d31.19999877425533!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14f5c3ef832cefdb%3A0x304d50967e6abf61!2sAlexandria%20Naval%20Unknown%20Soldier%20Memorial!5e1!3m2!1sar!2seg!4v1789025602093!5m2!1sar!2seg"
            title="خريطة النصب التذكاري للجندي البحري المجهول في المنشية"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
      </div>
    </section>

    <section class="pb-24 md:pb-32" aria-labelledby="parking-heading">
      <div class="container grid gap-8 lg:grid-cols-2">
        <div class="shell-border p-7 md:p-9">
          <span class="eyebrow">المواقف</span>
          <h2 id="parking-heading" class="mt-3 text-3xl font-black">لا تراهن على ركن السيارة أمام النصب.</h2>
          <p class="mt-4 text-slate-300">المنشية منطقة كثيفة الحركة، ومواقف الشارع تتغير بسرعة وقد تكون محدودة. إذا كنت بالسيارة فابحث عن موقف عام قانوني في وسط البلد واترك آخر جزء للمشي. في أوقات الذروة، سيارة الأجرة أو تطبيقات النقل غالباً أكثر راحة.</p>
        </div>
        <div class="shell-border p-7 md:p-9">
          <span class="eyebrow">نصيحة حركة</span>
          <h2 class="mt-3 text-3xl font-black">اجعل المشي جزءاً من الزيارة.</h2>
          <p class="mt-4 text-slate-300">النصب قريب من شبكة شوارع وسط الإسكندرية، لذلك من السهل الجمع بينه وبين محطة الرمل والمنشية وبحري في مسار واحد. تجنب التوقف العشوائي على الكورنيش أو في مناطق تعيق المرور.</p>
        </div>
      </div>
    </section>

    <section id="around" class="border-y border-[#d2aa68]/20 bg-[#081820] py-24 md:py-32">
      <div class="container grid gap-14 lg:grid-cols-2 lg:gap-20">
        <div>
          <span class="eyebrow">حولنا · أكل إسكندراني</span>
          <h2 class="section-title">من الساحة إلى الطاولة.</h2>
          <div class="mt-5">
            <article class="place-card"><small>سندوتشات سريعة · المنشية</small><strong>كبدة أبو حلمي</strong><p>اختيار محلي مباشر لتجربة الكبدة الإسكندراني بعد جولة قصيرة في الميدان.</p></article>
            <article class="place-card"><small>أسماك ومأكولات بحرية · المنشية</small><strong>قدورة</strong><p>من الأسماء المعروفة في الإسكندرية لتجربة السمك والمأكولات البحرية على الطريقة المحلية.</p></article>
            <article class="place-card"><small>فول وطعمية · وسط البلد</small><strong>محمد أحمد</strong><p>مطعم كلاسيكي قريب من نطاق محطة الرمل، مناسب لفطور أو وجبة مصرية بسيطة قبل أو بعد المشي.</p></article>
          </div>
          <p class="mt-5 text-xs text-slate-500">ساعات عمل المطاعم والأسعار تتغير؛ تحقق منها قبل الذهاب.</p>
        </div>
        <div>
          <span class="eyebrow">حولنا · معالم</span>
          <h2 class="section-title">أكمل خط الميناء.</h2>
          <div class="mt-5">
            <article class="place-card"><small>حوالي 20 دقيقة مشياً</small><strong>مسجد أبو العباس المرسي</strong><p>أحد أبرز معالم بحري، وقبة بارزة في المشهد العمراني القريب من الميناء.</p></article>
            <article class="place-card"><small>حوالي 28–30 دقيقة مشياً</small><strong>قلعة قايتباي</strong><p>قلعة مملوكية على طرف الميناء الشرقي، أُنشئت في القرن الخامس عشر في موضع فنار الإسكندرية القديم.</p></article>
            <article class="place-card"><small>وسط المدينة</small><strong>آثار كوم الدكة</strong><p>موقع أثري روماني يضيف طبقة مختلفة تماماً من تاريخ الإسكندرية إلى اليوم نفسه.</p></article>
            <article class="place-card"><small>شرقاً على الكورنيش</small><strong>مكتبة الإسكندرية</strong><p>معلم ثقافي حديث يمكن الوصول إليه بسيارة أجرة أو بالمواصلات من وسط البلد.</p></article>
          </div>
        </div>
      </div>
    </section>

