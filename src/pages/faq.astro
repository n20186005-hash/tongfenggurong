---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import FAQList from "../components/FAQList.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { faqItems, faqSchema } from "../data/faq";

const breadcrumbs = [
  { name: "首頁", path: "/" },
  { name: "常見問題", path: "/faq/" },
];
---

<BaseLayout
  title="通樑古榕常見問題"
  description="通樑古榕常見問題：門票、值不值得去、建議停留時間、是否為同一棵樹、樹齡、無障礙、洗手間、與跨海大橋一起玩、雨天與最新開放狀態查詢。"
  path="/faq/"
  breadcrumbs={breadcrumbs}
  schema={faqSchema(faqItems)}
>
  <PageHeader
    eyebrow="FAQ"
    title="通樑古榕常見問題"
    subtitle="門票、停留時間、無障礙、樹齡與雨天安排——出發前最常被問到的問題都在這裡。"
    breadcrumbs={breadcrumbs}
  />

  <section class="mx-auto max-w-3xl px-4 py-14 md:px-6">
    <FAQList items={faqItems} />
  </section>

  <RelatedLinks
    links={[
      { label: "參觀指南", href: "/visitor-guide/", desc: "值不值得去、看什麼" },
      { label: "交通與停車", href: "/transportation/", desc: "怎麼到、怎麼停" },
      { label: "歷史與傳說", href: "/history/", desc: "樹齡與由來" },
      { label: "氣根生態", href: "/aerial-roots/", desc: "是不是同一棵樹" },
    ]}
  />
</BaseLayout>
