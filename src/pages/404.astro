---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="الصفحة غير موجودة | النصب التذكاري للجندي البحري المجهول" description="الصفحة المطلوبة غير موجودة." robots="noindex,follow">
  <main class="container min-h-screen grid place-items-center py-16 text-center">
    <div>
      <img src="/brand/logo.svg" alt="شعار النصب التذكاري للجندي البحري المجهول" class="mx-auto mb-8 w-72 max-w-full" />
      <p class="eyebrow">404</p>
      <h1 class="section-title">هذه الصفحة أبحرت بعيداً.</h1>
      <p class="section-copy mx-auto">عد إلى الصفحة الرئيسية لمتابعة دليل زيارة النصب في المنشية.</p>
      <a class="btn-primary mt-6" href="/">العودة إلى الرئيسية</a>
    </div>
  </main>
</BaseLayout>
