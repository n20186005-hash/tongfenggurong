{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandria-naval-memorial",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
